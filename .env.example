# Skopiuj do .env (lokalnie) — NIGDY nie commituj prawdziwych wartości.

# Wygeneruj: openssl rand -hex 32
PAYLOAD_SECRET=

# Publiczny adres środowiska (bez trailing slash). Używany do budowy
# bezwzględnych URLi, CORS/CSRF allowlist oraz sitemap.
SERVER_URL=http://localhost:3000

# Poziom logowania Payload w produkcji: trace|debug|info|warn|error|fatal
PAYLOAD_LOG_LEVEL=info

# Publiczny adres bucketu R2 (jeśli podpięty pod custom domenę/CDN) —
# używany WYŁĄCZNIE do budowy URLi do plików, nigdy jako sekret.
NEXT_PUBLIC_MEDIA_URL=
